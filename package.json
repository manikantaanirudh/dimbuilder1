{
  "name": "onestream-xf-dimension-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --strictPort",
    "server": "npm run dev:api",
    "build": "tsc -p tsconfig.json && vite build",
    "docs:check": "node scripts/check-docs.mjs",
    "test": "vitest run",
    "test:postgres": "vitest run --no-file-parallelism src/test/postgresParity.test.ts src/test/postgresClient.test.ts src/test/postgresSchema.test.ts src/test/dbBootstrapSeeds.test.ts src/test/postgresBulkInsert.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview --host 127.0.0.1",
    "benchmark": "tsx scripts/autoresearch/benchmark.ts",
    "benchmark:cache": "tsx scripts/autoresearch/benchmark.ts --cache",
    "benchmark:quick": "tsx scripts/autoresearch/benchmark.ts --quick --skip-tests"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.12",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "nanoid": "^5.0.9",
    "openid-client": "^6.8.4",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "yaml": "^2.9.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "concurrently": "^9.1.2",
    "playwright": "^1.60.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
