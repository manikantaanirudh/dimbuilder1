# SR OneStream Dim Builder - Environment Variables
# Copy this file to .env and adjust values for your deployment.

# ─── Server ───────────────────────────────────────────────
PORT=8787

# ─── Database ─────────────────────────────────────────────
DATABASE_FILE=data/app.db
METADATA_DIRECTORY=metadata

# ─── Authentication ───────────────────────────────────────
# Set to "true" to enable authentication (default: false)
AUTH_ENABLED=false

# REQUIRED when auth is enabled. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Default admin credentials (only used on first run when auth is enabled)
ADMIN_EMAIL=admin@dimbuilder.local
ADMIN_PASSWORD=ChangeMe123!

# ─── Configuration ────────────────────────────────────────
# Path to YAML config file (default: config/dimbuilder.yaml)
DIMBUILDER_CONFIG_FILE=config/dimbuilder.yaml

# ─── Logging ──────────────────────────────────────────────
# Levels: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# ─── Environment ──────────────────────────────────────────
NODE_ENV=development
